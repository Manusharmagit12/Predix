# Predix — environment configuration (copy to .env and fill in; never commit .env)

# HTTP port for the server (default 3000)
PORT=3000

# "production" enables startup checks; "development"/empty is the default
NODE_ENV=development

# "pg" enables PostgreSQL persistence (or set DATABASE_URL below); empty = JSON journal
PREDIX_DB=

# PostgreSQL connection string (alternative to PREDIX_DB + standard PG* env vars)
DATABASE_URL=

# Alternative: leave DATABASE_URL empty and set PREDIX_DB=pg plus these values.
# Use KEY=value syntax, never PowerShell $env:KEY=value commands here.
# Quote passwords containing # or spaces. Never copy secrets into this example.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=predix

# npm commands load .env using Node >=20.12.0; shell variables take precedence.
# DATABASE_URL takes precedence over PG* settings when supplied.
# URL example: postgresql://USER:URL_ENCODED_PASSWORD@HOST:5432/DATABASE
# With DATABASE_URL, db:init migrates an existing database; create it beforehand.

# Admin account password — REQUIRED in production (startup is refused without it)
ADMIN_PASSWORD=
